<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Sign In' }) %>
<body class="min-h-screen flex flex-col bg-stone-50 text-stone-800 antialiased">

  <%- include('partials/header') %>
<!-- Login Page: Desert / Sand Theme -->
<main class="flex-1 flex flex-col justify-center items-center bg-stone-50 text-stone-800 px-4 py-8 relative overflow-hidden">

  <!-- Ambient Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[350px] bg-amber-200/30 blur-3xl rounded-full pointer-events-none -z-10"></div>

  <div class="w-full max-w-md my-auto">

    <!-- Card Container -->
    <div class="bg-stone-100 rounded-2xl border border-amber-200/80 shadow-xl p-6 sm:p-8 space-y-6">

      <!-- Header / Icon -->
      <div class="text-center space-y-2">
        <div class="inline-flex w-12 h-12 rounded-xl bg-amber-100 border border-amber-300/60 items-center justify-center text-amber-800 shadow-inner mb-1">
          <svg class="w-6 h-6 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
            <polyline points="10 17 15 12 10 7" />
            <line x1="15" y1="12" x2="3" y2="12" />
          </svg>
        </div>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight">
          Welcome Back
        </h1>
        <p class="text-xs sm:text-sm text-stone-500 font-sans">
          Enter your credentials to access your oasis
        </p>
      </div>

      <!-- Login Form -->
      <form action="/login" method="POST" class="space-y-4">

        <!-- Email Input -->
        <div class="space-y-1.5">
          <label for="email" class="block text-xs font-medium text-stone-700 uppercase tracking-wider">
            Email Address
          </label>
          <input
            type="email"
            id="email"
            name="username"
            required
            placeholder="caravaner@desert.com"
            class="w-full px-3.5 py-2.5 text-sm bg-stone-50 border border-stone-300/80 rounded-xl text-stone-800 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200 transition-all font-sans"
          />
        </div>

        <!-- Password Input -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="password" class="block text-xs font-medium text-stone-700 uppercase tracking-wider">
              Password
            </label>
          </div>
          <input
            type="password"
            id="password"
            name="password"
            required
            placeholder="••••••••"
            class="w-full px-3.5 py-2.5 text-sm bg-stone-50 border border-stone-300/80 rounded-xl text-stone-800 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200 transition-all font-mono"
          />
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full py-3 px-4 text-sm font-medium text-amber-950 bg-amber-300 hover:bg-amber-400 border border-amber-400/80 rounded-xl shadow-xs transition-all active:scale-[0.98] mt-2 cursor-pointer">
          Sign In
        </button>

      </form>

      <!-- Footer Link -->
      <div class="text-center border-t border-amber-200/50 pt-4">
        <p class="text-xs text-stone-500">
          Don't have an account?
          <a href="/register" class="font-medium text-amber-800 hover:text-amber-900 underline underline-offset-2 transition-colors">
            Sign Up
          </a>
        </p>
      </div>

    </div>

  </div>
</main>

<%- include('partials/footer') %>

</body>
</html>
