<!-- Hero Section: Unauthenticated Landing -->
<main class="flex-1 bg-stone-50 text-stone-800">

  <!-- Main Hero Container -->
  <section class="relative overflow-hidden py-16 lg:py-24 border-b border-amber-200/40">

    <!-- Decorative Ambient Glow (Desert Sun / Dune Effect) -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-amber-200/40 blur-3xl rounded-full pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">

        <!-- Left Column: Copy & Actions -->
        <div class="lg:col-span-7 text-center lg:text-left">

          <!-- Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100/80 border border-amber-300/60 text-amber-900 text-xs font-medium mb-6">
            <span class="w-2 h-2 rounded-full bg-amber-600 animate-pulse"></span>
            Cloud Storage for your Artifacts
          </div>

          <!-- Headline -->
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-stone-900 tracking-tight leading-none mb-6">
            A tranquil oasis for your <span class="text-amber-800 italic font-normal">digital memories</span>.
          </h1>

          <!-- Description -->
          <p class="text-lg text-stone-600 max-w-2xl mx-auto lg:mx-0 mb-8 font-sans leading-relaxed">
            Store, organize, and share your files securely in a minimal, clutter-free sanctuary. Built for speed, structured around your journey.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-10">
            <a href="/register" class="w-full sm:w-auto px-8 py-3.5 text-base font-medium text-amber-950 bg-amber-300 hover:bg-amber-400 border border-amber-400 rounded-xl shadow-xs transition-all duration-200 hover:shadow-md active:scale-95 text-center">
              Create Free Account
            </a>
            <a href="/login" class="w-full sm:w-auto px-8 py-3.5 text-base font-medium text-stone-700 bg-stone-100 hover:bg-amber-100/60 border border-stone-300/80 rounded-xl transition-all duration-200 text-center">
              Explore Demo Log In
            </a>
          </div>

          <!-- Quick Micro-Features -->
          <div class="grid grid-cols-3 gap-4 pt-6 border-t border-amber-200/50 max-w-lg mx-auto lg:mx-0 text-left">
            <div>
              <div class="font-mono text-xl font-bold text-stone-900">10 GB</div>
              <div class="text-xs text-stone-500">Free Storage</div>
            </div>
            <div>
              <div class="font-mono text-xl font-bold text-stone-900">E2E</div>
              <div class="text-xs text-stone-500">Encrypted Links</div>
            </div>
            <div>
              <div class="font-mono text-xl font-bold text-stone-900">100%</div>
              <div class="text-xs text-stone-500">Open Source</div>
            </div>
          </div>

        </div>

        <!-- Right Column: Visual Preview / Art -->
        <div class="lg:col-span-5">
          <div class="relative mx-auto max-w-md lg:max-w-none">

            <!-- Styled Window Mockup -->
            <div class="bg-stone-100 rounded-2xl border border-amber-200/80 shadow-xl overflow-hidden p-4 space-y-4">

              <!-- Window Top Bar -->
              <div class="flex items-center justify-between border-b border-stone-200 pb-3 px-1">
                <div class="flex items-center gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-stone-300"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-300/70"></div>
                  <div class="w-3 h-3 rounded-full bg-stone-300"></div>
                </div>
                <div class="text-xs font-mono text-stone-400">memory-caravan // storage</div>
              </div>

              <!-- Fake Upload Dropzone Area -->
              <div class="border-2 border-dashed border-amber-300/70 bg-amber-50/40 rounded-xl p-8 text-center flex flex-col items-center justify-center group hover:border-amber-400 transition-colors cursor-pointer">
                <div class="w-12 h-12 rounded-xl bg-amber-100 border border-amber-300/60 flex items-center justify-center text-amber-800 mb-3 group-hover:scale-105 transition-transform">
                  <svg class="w-6 h-6 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242" />
                    <path d="M12 12v9" />
                    <path d="m16 16-4-4-4 4" />
                  </svg>
                </div>
                <p class="text-sm font-medium text-stone-800 mb-1">Drop files here to upload</p>
                <p class="text-xs text-stone-500 font-mono">PNG, JPG, PDF up to 50MB</p>
              </div>

              <!-- Fake File Cards Preview -->
              <div class="space-y-2">
                <!-- Item 1 -->
                <div class="flex items-center justify-between p-2.5 rounded-lg bg-stone-50 border border-stone-200/80 text-xs">
                  <div class="flex items-center gap-2.5 truncate">
                    <div class="p-1.5 bg-amber-100 text-amber-900 rounded">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/></svg>
                    </div>
                    <span class="font-medium text-stone-700 truncate">desert_arch_backup.zip</span>
                  </div>
                  <span class="font-mono text-stone-400">12.4 MB</span>
                </div>
                <!-- Item 2 -->
                <div class="flex items-center justify-between p-2.5 rounded-lg bg-stone-50 border border-stone-200/80 text-xs">
                  <div class="flex items-center gap-2.5 truncate">
                    <div class="p-1.5 bg-stone-200 text-stone-700 rounded">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 002-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>
                    <span class="font-medium text-stone-700 truncate">caravan_route.png</span>
                  </div>
                  <span class="font-mono text-stone-400">3.8 MB</span>
                </div>
              </div>

            </div>

            <!-- Floating Badge Accent -->
            <div class="absolute -bottom-4 -left-4 bg-stone-900 text-amber-100 px-4 py-2.5 rounded-xl text-xs font-mono shadow-lg border border-stone-700 hidden sm:flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              PostgreSQL & Multer Powered
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

</main>
