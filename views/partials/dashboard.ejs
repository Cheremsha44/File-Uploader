<!-- Dashboard: Hyprland / Tiling Workspace (Desert Theme) -->
<main class="flex-1 bg-stone-50 text-stone-800 py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full space-y-8">

  <!-- 1. TOP CONTROL BAR / TOOLBAR -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-amber-200/60">

    <!-- Left: Breadcrumbs / Current Path -->
    <nav class="flex items-center gap-2 text-sm font-mono">
      <a class="flex items-center gap-1.5 text-stone-900 font-semibold hover:text-amber-800 transition-colors">
        <svg class="w-4 h-4 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span>oasis</span>
      </a>
      <span class="text-stone-400">/</span>
      <span class="text-stone-500">my-artifacts</span>
      <% if (currentFolder) { %>
        <span class="text-stone-400">/</span>
        <span class="text-stone-500"><%= currentFolder.name %></span>
      <% } %>
    </nav>

    <!-- Right: Search & Action Buttons -->
    <div class="flex flex-wrap items-center gap-3">

      <!-- Search Input -->
      <div class="relative flex-1 sm:w-64">
        <form id="filters" method="GET" action="/">
        <input
          type="text"
          name="q"
          value="<%= q %>"
          placeholder="Search artifacts..."
          class="w-full pl-9 pr-3.5 py-2 text-xs bg-stone-100 border border-stone-300/80 rounded-xl text-stone-800 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200 transition-all font-sans"
        />
        <button
              type="submit"
              aria-label="Search"
              class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-amber-800 transition-colors cursor-pointer border-none bg-transparent p-0 flex items-center justify-center focus:outline-none">
              <svg class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
              </svg>
            </button>
        </form>
      </div>

      <!-- Action: New Folder -->
      <button
        onclick="document.getElementById('new-folder-modal').showModal()"
        class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-medium text-stone-700 bg-stone-100 hover:bg-amber-100/60 border border-stone-300/80 rounded-xl transition-all cursor-pointer">
        <svg class="w-4 h-4 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        New Folder
      </button>

      <!-- Action: Upload File Trigger -->
      <label for="file-input" class="inline-flex items-center gap-2 px-4 py-2 text-xs font-medium text-amber-950 bg-amber-300 hover:bg-amber-400 border border-amber-400/80 rounded-xl shadow-2xs transition-all active:scale-95 cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        Upload File
      </label>

    </div>
  </div>


  <!-- 2. DRAG & DROP ALTAR (UPLOAD ZONE) -->
  <section class="relative">
    <form action="<%= currentFolder ? '/folders/' + currentFolder.id + '/upload' : '/upload' %>" method="POST" enctype="multipart/form-data" id="upload-form">
      <div
        id="dropzone"
        class="border-2 border-dashed border-amber-300/80 bg-amber-50/30 hover:bg-amber-100/30 hover:border-amber-400 rounded-2xl p-8 text-center transition-all cursor-pointer group flex flex-col items-center justify-center relative overflow-hidden">

        <input type="file" name="file" id="file-input" onchange="this.form.submit()" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />

        <div class="w-12 h-12 rounded-2xl bg-amber-100 border border-amber-300/60 flex items-center justify-center text-amber-800 mb-3 group-hover:scale-110 transition-transform shadow-inner">
          <svg class="w-6 h-6 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="1.8">
            <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>
            <path d="M12 12v9"/><path d="m16 16-4-4-4 4"/>
          </svg>
        </div>

        <h3 class="font-serif text-lg font-semibold text-stone-900 mb-1">
          Drag & drop your files here, or <span class="text-amber-800 underline underline-offset-2">browse</span>
        </h3>
        <p class="text-xs text-stone-500 font-mono">
          Supports image, document, archive formats up to 50MB
        </p>
      </div>
    </form>
  </section>


  <% if (!currentFolder) { %>
    <!-- 3. FOLDERS SECTION (Tiling Grid) -->
    <section class="space-y-4">
        <div class="flex items-center justify-between">
        <h2 class="font-serif text-lg font-bold text-stone-900 tracking-tight flex items-center gap-2">
            <span>Folders</span>
            <span class="text-xs font-mono font-normal text-stone-400 bg-stone-200/60 px-2 py-0.5 rounded-full"><%= folders.length %></span>
        </h2>
        </div>

        <!-- Folder Tiles -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            <% folders.forEach(folder => { %>
                <div class="group bg-stone-100 border border-amber-200/70 hover:border-amber-300 rounded-2xl p-4 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between h-32 relative overflow-hidden">

                  <!-- 1. ПРОЗРАЧНАЯ ССЫЛКА НА ВСЮ ПЛИТКУ (z-10) -->
                  <a href="/folders/<%= folder.id %>" class="absolute inset-0 z-10 focus:outline-none" aria-label="Open <%= folder.name %>"></a>

                  <!-- 2. ВЕРХНЯЯ СТРОКА: Иконка + Кол-во файлов -->
                  <div class="flex items-start justify-between relative z-20 pointer-events-none">
                    <div class="w-10 h-10 rounded-xl bg-amber-100 border border-amber-300/50 flex items-center justify-center text-amber-800 group-hover:scale-105 transition-transform">
                      <svg class="w-5 h-5 fill-amber-200/60 stroke-current" viewBox="0 0 24 24" stroke-width="2">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                      </svg>
                    </div>
                    <span class="text-xs font-mono text-stone-400"><%= folder._count.files %> files</span>
                  </div>

                  <!-- 3. НИЖНЯЯ СТРОКА: Название + Кнопки действий (z-20) -->
                  <div class="w-full relative z-20">

                    <!-- STATE 1: Обычный вид (Текст + Карандаш + Корзина) -->
                    <div id="folder-title-<%= folder.id %>" class="flex items-center justify-between gap-1.5">
                      <div class="truncate pointer-events-none">
                        <h3 class="font-medium text-stone-800 truncate group-hover:text-amber-900 transition-colors"><%= folder.name %></h3>
                        <p class="text-xs text-stone-400 font-mono mt-0.5"><%= folder.createdAt.toLocaleDateString() %></p>
                      </div>

                      <!-- Action Buttons Area -->
                      <div class="flex items-center gap-1 shrink-0">
                        <!-- Редактировать (Карандаш) -->
                        <button
                          type="button"
                          onclick="event.preventDefault(); event.stopPropagation(); toggleFolderEdit('<%= folder.id %>')"
                          title="Edit name"      orderBy: { createdAt: 'desc' },
                          class="p-1.5 text-stone-400 hover:text-amber-900 hover:bg-amber-200/60 rounded-lg transition-colors cursor-pointer">
                          <svg class="w-3.5 h-3.5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                        </button>

                        <!-- Удалить (Корзина) -->
                        <form action="/folders/<%= folder.id %>/delete" method="POST" class="inline" onclick="event.stopPropagation()">
                          <button
                            type="submit"
                            onclick="return confirm('Delete folder and all its contents?')"
                            title="Delete folder"
                            class="p-1.5 text-stone-400 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer">
                            <svg class="w-3.5 h-3.5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                              <polyline points="3 6 5 6 21 6"/>
                              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                            </svg>
                          </button>
                        </form>
                      </div>
                    </div>

                    <!-- STATE 2: Форма редактирования (Инпут + Галочка + Крестик) -->
                    <form
                      id="folder-form-<%= folder.id %>"
                      action="/folders/<%= folder.id %>/rename"
                      method="POST"
                      class="hidden items-center gap-1.5 w-full">

                      <input
                        type="text"
                        name="newName"
                        value="<%= folder.name %>"
                        required
                        autofocus
                        onclick="event.stopPropagation()"
                        class="w-full px-2 py-1 text-xs bg-stone-50 border border-amber-400 rounded-lg text-stone-800 focus:outline-none focus:ring-1 focus:ring-amber-500 font-sans"
                      />

                      <button
                        type="submit"
                        onclick="event.stopPropagation()"
                        title="Save"
                        class="p-1.5 bg-amber-300 hover:bg-amber-400 text-amber-950 border border-amber-400 rounded-lg transition-all cursor-pointer shrink-0 shadow-2xs">
                        <svg class="w-3.5 h-3.5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      </button>

                      <button
                        type="button"
                        onclick="event.preventDefault(); event.stopPropagation(); toggleFolderEdit('<%= folder.id %>')"
                        title="Cancel"
                        class="p-1.5 text-stone-400 hover:text-stone-600 rounded-lg transition-colors cursor-pointer shrink-0">
                        <svg class="w-3.5 h-3.5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                      </button>
                    </form>

                  </div>

                </div>
            <% }) %>
        </div>
    </section>
  <% } %>

  <!-- 4. FILES SECTION (Hyprland Tile Cards) -->
  <section class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="font-serif text-lg font-bold text-stone-900 tracking-tight flex items-center gap-2">
        <span><%= currentFolder ? currentFolder.name : 'Recent Files' %></span>
        <span class="text-xs font-mono font-normal text-stone-400 bg-stone-200/60 px-2 py-0.5 rounded-full"><%= files.length %></span>
      </h2>

      <!-- Sort Options -->
      <div class="flex items-center gap-2 text-xs font-mono text-stone-500">
        <span>Sort:</span>
        <select name="sort" form="filters" onchange="this.form.submit()" class="bg-transparent border-none text-stone-800 font-semibold focus:outline-none cursor-pointer">
            <option value="date" <%= sort === 'date' ? 'selected' : '' %>>Date added</option>
             <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Name</option>
             <option value="size" <%= sort === 'size' ? 'selected' : '' %>>Size</option>
        </select>
      </div>
    </div>

    <!-- Files Tiling Grid -->

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <% files.forEach(file => { %>
            <!-- File Card 1 (Image) -->
            <div class="group bg-stone-100 border border-stone-200/80 hover:border-amber-300 rounded-2xl p-4 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between h-48 relative">
              <!-- Top: Type Badge & Action -->
              <%
                const isImage = file.mimetype.startsWith('image/');
                const isDoc = file.mimetype === 'application/pdf' || file.mimetype.startsWith('text/');
                const tone = isImage
                  ? 'bg-amber-100 text-amber-900'
                  : isDoc
                    ? 'bg-stone-200 text-stone-700'
                    : 'bg-yellow-100 text-yellow-800';
              %>
              <div class="flex items-start justify-between">
                <div class="p-2 rounded-xl <%= tone %>">
                  <% if (isImage) { %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
                    </svg>
                  <% } else if (isDoc) { %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                    </svg>
                  <% } else { %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/>
                    </svg>
                  <% } %>
                </div>

                <div class="flex items-center gap-1 opacity-80 group-hover:opacity-100 transition-opacity">

                  <!-- Кнопка Share (Копировать ссылку) -->
                  <button
                    type="button"
                    onclick="shareFile('<%= file.id %>', this)"
                    title="Copy share link (7 days)"
                    class="p-1.5 text-stone-500 hover:text-amber-900 hover:bg-stone-200/60 rounded-lg transition-colors cursor-pointer">
                    <!-- Иконка ссылки -->
                    <svg class="w-4 h-4 icon-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </svg>
                    <!-- Иконка галочки (скрыта по умолчанию) -->
                    <svg class="w-4 h-4 icon-check hidden text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                  </button>

                  <!-- Кнопка Download -->
                  <a href="/download/<%= file.id %>" method="GET" title="Download" class="p-1.5 text-stone-500 hover:text-amber-900 hover:bg-stone-200/60 rounded-lg transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  </a>

                  <!-- Кнопка Delete -->
                  <form action="/delete-file/<%= file.id %>" method="POST" class="inline">
                    <button title="Delete" class="p-1.5 text-stone-400 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    </button>
                  </form>
                </div>
                </div>

              <!-- Middle: Preview or Details -->
              <div class="my-auto py-2">
                <h3 class="font-medium text-sm text-stone-800 truncate group-hover:text-amber-900 transition-colors" title="caravan_dune_arch.png">
                  <%= file.name %>
                </h3>
                <p class="text-xs font-mono text-stone-400 mt-1"><%= file.mimetype %></p>
              </div>

              <!-- Bottom: Size & Date -->
              <div class="flex items-center justify-between text-xs font-mono text-stone-400 pt-2 border-t border-stone-200/60">
                <span><%= (file.size / 1024 / 1024).toFixed(1) %> MB</span>
                <span><%= file.createdAt.toLocaleDateString() %></span>
              </div>
            </div>
        <% }) %>
    </div>
  </section>

</main>


<!-- 5. NEW FOLDER MODAL (HTML Dialog) -->
<dialog id="new-folder-modal" class="rounded-2xl border border-amber-200 shadow-2xl bg-stone-100 p-6 backdrop:bg-stone-900/40 backdrop:backdrop-blur-xs max-w-sm w-full font-sans">
  <form action="/create-folder" method="POST" class="space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="font-serif text-lg font-bold text-stone-900">Create New Folder</h3>
      <button type="button" onclick="document.getElementById('new-folder-modal').close()" class="text-stone-400 hover:text-stone-600 text-sm font-mono cursor-pointer">✕</button>
    </div>
    <div>
      <label class="block text-xs font-medium text-stone-700 uppercase tracking-wider mb-1">Folder Name</label>
      <input type="text" name="name" required placeholder="e.g. Project Assets" class="w-full px-3.5 py-2 text-sm bg-stone-50 border border-stone-300 rounded-xl text-stone-800 focus:outline-none focus:border-amber-500 font-sans" />
    </div>
    <div class="flex items-center justify-end gap-2 pt-2">
      <button type="button" onclick="document.getElementById('new-folder-modal').close()" class="px-3.5 py-2 text-xs font-medium text-stone-600 hover:bg-stone-200/50 rounded-xl">Cancel</button>
      <button type="submit" class="px-4 py-2 text-xs font-medium text-amber-950 bg-amber-300 hover:bg-amber-400 rounded-xl border border-amber-400 cursor-pointer">Create</button>
    </div>
  </form>
</dialog>

<script>
  function toggleFolderEdit(id) {
    const titleBlock = document.getElementById(`folder-title-${id}`);
    const formBlock = document.getElementById(`folder-form-${id}`);

    titleBlock.classList.toggle('hidden');
    formBlock.classList.toggle('hidden');
    formBlock.classList.toggle('flex');
  }

  async function shareFile(fileId, btn) {
    try {
      const res = await fetch(`/share/${fileId}`);
      const data = await res.json();

      if (!res.ok || !data.url) {
        alert('Не удалось создать ссылку для шаринга');
        return;
      }

      await navigator.clipboard.writeText(data.url);

      // Показываем галочку на 2 секунды
      const linkIcon = btn.querySelector('.icon-link');
      const checkIcon = btn.querySelector('.icon-check');

      linkIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');

      setTimeout(() => {
        checkIcon.classList.add('hidden');
        linkIcon.classList.remove('hidden');
      }, 2000);
    } catch (err) {
      console.error('Ошибка при копировании ссылки:', err);
    }
  }
</script>
