<!-- Shared Guest Landing / Teaser (Desert Theme) -->
<main class="flex-1 bg-stone-50 text-stone-800 py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full space-y-8">

  <!-- 1. BREADCRUMBS -->
  <div class="flex items-center justify-between gap-4 pb-6 border-b border-amber-200/60">
    <nav class="flex items-center gap-2 text-sm font-mono">
      <a href="/" class="flex items-center gap-1.5 text-stone-900 font-semibold hover:text-amber-800 transition-colors">
        <svg class="w-4 h-4 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span>oasis</span>
      </a>
      <span class="text-stone-400">/</span>
      <span class="text-stone-500">public-share-hub</span>
    </nav>

    <div class="inline-flex items-center gap-1.5 text-xs font-mono text-amber-900 bg-amber-100 border border-amber-300/60 px-3 py-1 rounded-full">
      <svg class="w-3.5 h-3.5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>Требуется вход</span>
    </div>
  </div>

  <!-- 2. HERO TEASER & CALL TO ACTION -->
  <section class="relative bg-amber-50/40 border border-amber-200/80 rounded-3xl p-8 sm:p-12 overflow-hidden shadow-2xs">
    <!-- Фоновый декоративный элемент дюны/оазиса -->
    <div class="absolute -right-12 -bottom-12 w-64 h-64 bg-amber-200/20 rounded-full blur-2xl pointer-events-none"></div>

    <div class="max-w-2xl space-y-5 relative z-10">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-amber-900 bg-amber-200/60 px-3 py-1 rounded-xl">
        <span>Caravan Link Sharing Hub</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-stone-900 tracking-tight leading-tight">
        Делись своими файлами по одной защищенной ссылке.
      </h1>

      <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
        Авторизуйся в оазисе, чтобы открывать публичный доступ к своим документам и архивам. Получателям ссылки не нужен аккаунт — они смогут мгновенно скачать файл до <strong>50 МБ</strong> в один клик.
      </p>

      <!-- Auth Action Buttons -->
      <div class="pt-3 flex flex-wrap items-center gap-3 font-sans">
        <a href="/login" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-amber-950 bg-amber-300 hover:bg-amber-400 border border-amber-400 rounded-xl shadow-2xs transition-all active:scale-95">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          Войти в аккаунт
        </a>
        <a href="/register" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-stone-700 bg-stone-100 hover:bg-amber-100/60 border border-stone-300/80 rounded-xl transition-all">
          Создать караван
        </a>
      </div>
    </div>
  </section>

  <!-- 3. WHAT YOU CAN DO (Feature Preview Grid) -->
  <section class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="font-serif text-lg font-bold text-stone-900 tracking-tight flex items-center gap-2">
        <span>Что станет доступно после входа</span>
        <span class="text-xs font-mono font-normal text-stone-400 bg-stone-200/60 px-2 py-0.5 rounded-full">Features</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <!-- Feature 1 -->
      <div class="bg-stone-100 border border-amber-200/70 rounded-2xl p-6 space-y-3 shadow-2xs flex flex-col justify-between">
        <div class="w-10 h-10 rounded-xl bg-amber-100 border border-amber-300/60 flex items-center justify-center text-amber-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
        </div>
        <div>
          <h3 class="font-serif font-bold text-stone-900 text-base">Генерация ссылок в 1 клик</h3>
          <p class="text-xs text-stone-600 mt-1.5 leading-relaxed">
            Выбирай любой загруженный файл или папку и получай готовую ссылку для отправки коллегам или друзьям в мессенджерах.
          </p>
        </div>
      </div>

      <!-- Feature 2 -->
      <div class="bg-stone-100 border border-amber-200/70 rounded-2xl p-6 space-y-3 shadow-2xs flex flex-col justify-between">
        <div class="w-10 h-10 rounded-xl bg-amber-100 border border-amber-300/60 flex items-center justify-center text-amber-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div>
          <h3 class="font-serif font-bold text-stone-900 text-base">Контроль срока жизни</h3>
          <p class="text-xs text-stone-600 mt-1.5 leading-relaxed">
            Создавай ссылки с ограниченным временем доступа (на 24 часа, 7 дней) или оставляй бессрочный доступ по необходимости.
          </p>
        </div>
      </div>

      <!-- Feature 3 -->
      <div class="bg-stone-100 border border-amber-200/70 rounded-2xl p-6 space-y-3 shadow-2xs flex flex-col justify-between">
        <div class="w-10 h-10 rounded-xl bg-amber-100 border border-amber-300/60 flex items-center justify-center text-amber-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/>
          </svg>
        </div>
        <div>
          <h3 class="font-serif font-bold text-stone-900 text-base">Мгновенный отзыв доступа</h3>
          <p class="text-xs text-stone-600 mt-1.5 leading-relaxed">
            В любой момент можно удалить или деактивировать публичную ссылку — файл тут же перестанет отдаваться наружу.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- 4. INTERACTIVE DEMO PREVIEW (Как это выглядит изнутри) -->
  <section class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="font-serif text-lg font-bold text-stone-900 tracking-tight flex items-center gap-2">
        <span>Интерфейс расшаривания (Демо-превью)</span>
      </h2>
      <span class="text-xs font-mono text-stone-400">Read-only preview</span>
    </div>

    <!-- Задизейбленная демо-карточка в стиле дашборда -->
    <div class="bg-stone-100 border border-stone-200/80 rounded-2xl p-6 relative overflow-hidden">
      <div class="max-w-md bg-stone-50 border border-amber-200/80 rounded-2xl p-4 shadow-sm space-y-3 opacity-90 mx-auto sm:mx-0">

        <div class="flex items-start justify-between">
          <div class="p-2 rounded-xl bg-amber-100 text-amber-900">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
            </svg>
          </div>
          <span class="text-xs font-mono text-emerald-800 bg-emerald-100/80 border border-emerald-300/60 px-2 py-0.5 rounded-full">
            Active link
          </span>
        </div>

        <div>
          <h4 class="font-medium text-stone-900 text-sm">desert_sunset_wallpaper.png</h4>
          <p class="text-xs font-mono text-stone-400">4.2 MB • image/png • 0 скачиваний</p>
        </div>

        <div class="flex items-center gap-2 pt-2 border-t border-stone-200/60">
          <div class="w-full px-2.5 py-1.5 text-xs font-mono bg-stone-100 border border-stone-300/70 rounded-lg text-stone-400 select-none">
            https://caravan.app/s/sample-link-preview
          </div>
          <button type="button" disabled class="px-3 py-1.5 text-xs font-mono bg-stone-200 text-stone-400 rounded-lg cursor-not-allowed">
            Copy
          </button>
        </div>
      </div>

      <!-- Плашка поверх, если захочешь кликнуть -->
      <div class="mt-4 sm:mt-0 sm:absolute sm:inset-y-0 sm:right-6 sm:flex sm:items-center">
        <div class="text-center sm:text-right space-y-1">
          <p class="text-xs font-mono text-stone-500">Хочешь делиться своими файлами так же?</p>
          <a href="/login" class="inline-block text-xs font-bold text-amber-800 hover:text-amber-950 underline underline-offset-2">
            Авторизоваться через JWT &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

</main>
